    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "openai.chatgpt",
                "Anthropic.claude-code",
                "ms-python.python",
                "charliermarsh.ruff",
                "eamodio.gitlens"
            ]
